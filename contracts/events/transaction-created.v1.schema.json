{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transaction-monitoring.local/contracts/transaction-created.v1.schema.json",
  "title": "Transaction created event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "produced_at", "data"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "transaction.created" },
    "event_version": { "const": 1 },
    "produced_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "account_id",
        "merchant_id",
        "amount",
        "currency",
        "country",
        "status",
        "occurred_at"
      ],
      "properties": {
        "transaction_id": { "type": "string", "format": "uuid" },
        "account_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "merchant_id": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "null" }
          ]
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]{1,16}(\\.[0-9]{1,2})?$"
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "status": { "enum": ["pending", "completed", "failed"] },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
