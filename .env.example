# Local development defaults. Docker Compose works without copying this file.
POSTGRES_DB=transactions
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
# Optional override for Python/Alembic run outside Compose:
# DATABASE_URL=postgresql+psycopg://monitoring:local-development-only@127.0.0.1:5432/transactions
# Required only for PostgreSQL integration tests (isolated schemas are created):
# TEST_DATABASE_URL=postgresql+psycopg://monitoring:local-development-only@127.0.0.1:5432/transactions
REDIS_PORT=6379
KAFKA_PORT=9092
API_PORT=8000
WEB_PORT=5173
WORKER_HEARTBEAT_SECONDS=30
