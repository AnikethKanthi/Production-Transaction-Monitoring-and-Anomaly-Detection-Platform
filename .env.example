# Local development defaults. Docker Compose works without copying this file.
POSTGRES_DB=transactions
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
# Optional override for Python/Alembic run outside Compose:
# DATABASE_URL=postgresql+psycopg://monitoring:local-development-only@127.0.0.1:5432/transactions
# Required only for PostgreSQL integration tests (isolated schemas are created):
# TEST_DATABASE_URL=postgresql+psycopg://monitoring:local-development-only@127.0.0.1:5432/transactions
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
METRICS_CACHE_TTL_SECONDS=60
ROLLING_METRICS_TTL_SECONDS=7200
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CONSUMER_GROUP=transaction-processor-v1
KAFKA_POLL_TIMEOUT_SECONDS=1
KAFKA_MAX_PROCESSING_ATTEMPTS=3
KAFKA_RETRY_BACKOFF_SECONDS=0.5
MODEL_PATH=model-artifacts/isolation_forest.v1.joblib
MODEL_METADATA_PATH=model-artifacts/isolation_forest.v1.metadata.json
WORKER_METRICS_PORT=9101
API_PORT=8000
WEB_PORT=5173
